+) {
+  if (typeof window === "undefined" || !id) return;
+  const clean = <T>(rec: Record<number, T>): Record<string, T> => {
+    const out: Record<string, T> = {};
+    for (const [k, v] of Object.entries(rec)) if (v !== undefined) out[k] = v;
