+
+    def test_wrong_mime_for_pdf_extension(self):
+        with self.assertRaises(ValueError) as ctx:
+            validate_resume_upload_file("application/msword", "file.pdf")
+        self.assertIn("pdf", str(ctx.exception).lower())
