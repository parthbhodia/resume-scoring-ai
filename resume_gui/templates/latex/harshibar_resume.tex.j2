\documentclass[letterpaper,11pt]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\usepackage{fontawesome5}
\usepackage[scale=0.90,lf]{FiraMono}
\usepackage{contour}
\usepackage[normalem]{ulem}
\usepackage{helvet}
\renewcommand*\familydefault{\sfdefault}
\usepackage[T1]{fontenc}

\definecolor{light-grey}{gray}{0.83}
\definecolor{dark-grey}{gray}{0.3}
\definecolor{text-grey}{gray}{.08}

{% raw %}
\renewcommand{\ULdepth}{1.8pt}
\contourlength{0.8pt}
\newcommand{\myuline}[1]{%
  \uline{\phantom{#1}}%
  \llap{\contour{white}{#1}}%
}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{0in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.5in}
\addtolength{\textheight}{1.0in}

\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

\titleformat {\section}{
    \bfseries \vspace{2pt} \raggedright \large
}{}{0em}{}[\color{light-grey} {\titlerule[2pt]} \vspace{-4pt}]

\newcommand{\resumeItem}[1]{
  \item\small{#1 \vspace{-1pt}}
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-1pt}\item
    \begin{tabular*}{\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & {\color{dark-grey}\small #2}\vspace{1pt}\\
      \textit{#3} & {\color{dark-grey} \small #4}\\
    \end{tabular*}\vspace{-4pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{\textwidth}{l@{\extracolsep{\fill}}r}
      #1 & {\color{dark-grey} #2} \\
    \end{tabular*}\vspace{-4pt}
}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{0pt}}
{% endraw %}

\color{text-grey}

\begin{document}

\begin{center}
    \textbf{\Huge {{ doc.full_name|latex }}} \\ \vspace{5pt}
    \small {{ doc.phone|latex }}{% if doc.phone %} | {% endif %}{{ doc.email|latex }}{% if doc.email %} | {% endif %}{{ doc.linkedin|latex }}{% if doc.linkedin %} | {% endif %}{{ doc.github|latex }}{% if doc.github %} | {% endif %}{{ doc.location|latex }}
    \\ \vspace{-3pt}
\end{center}

{% if doc.summary %}
\section{SUMMARY}
\small {{ doc.summary|latex }}
{% endif %}

{% if doc.experience|length %}
\section{EXPERIENCE}
\resumeSubHeadingListStart
{% for exp in doc.experience %}
  \resumeSubheading
    { {{ exp.company|latex }} }
    { {{ exp.dates|latex if exp.dates else '' }} }
    { {{ exp.role|latex }} }
    { {{ exp.location|latex if exp.location else '' }} }
  \resumeItemListStart
  {% for bullet in exp.bullets %}
    \resumeItem{ {{ bullet|latex }} }
  {% endfor %}
  \resumeItemListEnd
{% endfor %}
\resumeSubHeadingListEnd
{% endif %}

{% set projects = [] %}
{% set education = [] %}
{% set other = [] %}
{% for sec in doc.extra_sections %}
  {% set lname = sec[0]|lower %}
  {% if lname in ['projects', 'project'] %}
    {% set _ = projects.append(sec) %}
  {% elif lname == 'education' %}
    {% set _ = education.append(sec) %}
  {% else %}
    {% set _ = other.append(sec) %}
  {% endif %}
{% endfor %}

{% if projects|length %}
\section{PROJECTS}
\resumeSubHeadingListStart
{% for sec in projects %}
  \resumeProjectHeading{\textbf{ {{ sec[0]|latex }} }}{}
  \resumeItemListStart
  {% for b in sec[1] %}
    \resumeItem{ {{ b|latex }} }
  {% endfor %}
  \resumeItemListEnd
{% endfor %}
\resumeSubHeadingListEnd
{% endif %}

{% if education|length %}
\section{EDUCATION}
\resumeSubHeadingListStart
{% for sec in education %}
  \resumeProjectHeading{\textbf{ {{ sec[0]|latex }} }}{}
  \resumeItemListStart
  {% for b in sec[1] %}
    \resumeItem{ {{ b|latex }} }
  {% endfor %}
  \resumeItemListEnd
{% endfor %}
\resumeSubHeadingListEnd
{% endif %}

{% if doc.skills|length %}
\section{SKILLS}
\begin{itemize}[leftmargin=0in, label={}]
\small{\item{
{% for skill in doc.skills %}
\textbf{ {{ skill[0]|latex }} }{: {{ skill[1]|join(', ')|latex }}}
{% if not loop.last %}\vspace{2pt} \\{% endif %}
{% endfor %}
}}
\end{itemize}
{% endif %}

{% if other|length %}
{% for sec in other %}
\section{ {{ sec[0]|latex }} }
\begin{itemize}
{% for b in sec[1] %}
  \item {{ b|latex }}
{% endfor %}
\end{itemize}
{% endfor %}
{% endif %}

\end{document}
