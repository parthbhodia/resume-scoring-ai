\documentclass[letterpaper,10pt]{article}
\usepackage[margin=0.7in]{geometry}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage{enumitem}
\usepackage{needspace}
\setlist[itemize]{leftmargin=1.1em, itemsep=2pt, topsep=2pt}
\pagenumbering{gobble}

\begin{document}
\widowpenalty=5000
\clubpenalty=5000

{\LARGE \textbf{ {{ doc.full_name|latex }} }}\\
{% if doc.headline %}
{{ doc.headline|latex }}\\
{% endif %}
{% set contact = [] %}
{% if doc.location %}{% set _ = contact.append(doc.location) %}{% endif %}
{% if doc.email %}{% set _ = contact.append(doc.email) %}{% endif %}
{% if doc.phone %}{% set _ = contact.append(doc.phone) %}{% endif %}
{% if doc.linkedin %}{% set _ = contact.append(doc.linkedin) %}{% endif %}
{% if doc.github %}{% set _ = contact.append(doc.github) %}{% endif %}
{% if contact|length %}{{ contact|join(' | ')|latex }}\\{% endif %}

{% if doc.summary %}
\vspace{0.5em}
\needspace{4\baselineskip}
\section*{Summary}
{{ doc.summary|latex }}
{% endif %}

{% if doc.skills|length %}
\needspace{6\baselineskip}
\section*{Technical Skills}
{% for skill in doc.skills %}
\textbf{ {{ skill[0]|latex }} }: {{ skill[1]|join(', ')|latex }}\\
{% endfor %}
{% endif %}

{% if doc.experience|length %}
\needspace{6\baselineskip}
\section*{Experience}
{% for exp in doc.experience %}
{% set job_lines = 5 + (exp.bullets|length) * 3 %}
\needspace{ {{ [job_lines, 32]|min }} \baselineskip}
\textbf{ {{ exp.company|latex }} }{% if exp.location %} --- {{ exp.location|latex }}{% endif %}\\
\textit{ {{ exp.role|latex }}{% if exp.dates %} | {{ exp.dates|latex }}{% endif %} }\\
\begin{itemize}
{% for bullet in exp.bullets %}
\needspace{2.8\baselineskip}
\item {{ bullet|bullet_latex }}
{% endfor %}
\end{itemize}
{% endfor %}
{% endif %}

{% if doc.projects|length %}
\needspace{6\baselineskip}
\section*{Projects}
{% for proj in doc.projects %}
\needspace{4\baselineskip}
{% if proj.name %}
\textbf{ {{ proj.name|latex }} }\\[2pt]
{% endif %}
{% if proj.bullets|length %}
\begin{itemize}
{% for bullet in proj.bullets %}
\needspace{2.8\baselineskip}
\item {{ bullet|bullet_latex }}
{% endfor %}
\end{itemize}
{% endif %}
{% endfor %}
{% endif %}

{% if doc.education|length %}
\needspace{6\baselineskip}
\section*{Education}
{% for edu in doc.education %}
\needspace{4\baselineskip}
\textbf{ {{ edu.institution|latex }} }{% if edu.dates %} --- {{ edu.dates|latex }}{% endif %}\\
\textit{ {{ edu.degree|latex }} }{% if edu.location %} --- {{ edu.location|latex }}{% endif %}\\[2pt]
{% if edu.bullets|length %}
\begin{itemize}
{% for bullet in edu.bullets %}
\needspace{2.8\baselineskip}
\item {{ bullet|bullet_latex }}
{% endfor %}
\end{itemize}
{% endif %}
{% endfor %}
{% endif %}

{% if doc.extra_sections|length %}
{% for sec in doc.extra_sections %}
{% set lname = sec[0]|lower %}
{% if (doc.projects|length and lname in ['projects', 'project']) or (doc.education|length and lname == 'education') %}
{% else %}
\needspace{6\baselineskip}
\section*{ {{ sec[0]|latex }} }
\begin{itemize}
{% for line in sec[1] %}
\needspace{2.8\baselineskip}
\item {{ line|latex }}
{% endfor %}
\end{itemize}
{% endif %}
{% endfor %}
{% endif %}

\end{document}
